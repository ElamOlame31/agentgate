# ── Required ────────────────────────────────────────────────────────────────

# Anthropic API key — used for natural language policy parsing and
# human-readable decision explanations. Get one at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── AgentGate API Security ──────────────────────────────────────────────────

# Secret key that all SDK clients must pass in the X-API-Key header.
# If unset, auth is disabled (fine for local dev, required for production).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTGATE_API_KEY=

# ── Server ──────────────────────────────────────────────────────────────────

AGENTGATE_PORT=8000

# Comma-separated origins allowed to call the API from a browser.
# Defaults to http://localhost:8000 if unset.
# AGENTGATE_CORS_ORIGINS=https://yourdomain.com,http://localhost:3000

# ── Push Alerts (optional) ──────────────────────────────────────────────────

# ntfy.sh topic to receive real-time alerts on DENY / ESCALATE decisions.
# Get a free topic at https://ntfy.sh — no account needed.
# AGENTGATE_ALERT_TOPIC=your-ntfy-topic

# Set to "true" to receive alerts on ESCALATE decisions (default: false)
# AGENTGATE_ALERT_ON_ESCALATE=true

# Set to "false" to suppress DENY alerts (default: true)
# AGENTGATE_ALERT_ON_DENY=true

# ── Explainer (optional) ────────────────────────────────────────────────────

# Set to "false" to disable Claude-generated explanations (faster, cheaper).
# Decisions still work — you just won't get human-readable explanations.
# AGENTGATE_EXPLAINER_ENABLED=true

# ── Audit Retention (optional) ──────────────────────────────────────────────

# How many days of audit log to keep (default: 90)
# AGENTGATE_AUDIT_RETENTION_DAYS=90

# ── Environment ─────────────────────────────────────────────────────────────

AGENTGATE_ENV=development
