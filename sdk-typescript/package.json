{
  "name": "agentgate-pdp",
  "version": "0.3.0",
  "description": "Runtime authorization for autonomous AI agents, with receipts an auditor can verify offline",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "vectors": "python test/generate_vectors.py",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ai",
    "agents",
    "security",
    "authorization",
    "langchain",
    "openai",
    "anthropic",
    "policy",
    "pdp",
    "agentgate",
    "audit",
    "receipts",
    "provenance",
    "agentic"
  ],
  "author": "Elam Olame Mugabo <eomugabo@synai.solutions>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElamOlame31/agentgate-public.git",
    "directory": "sdk-typescript"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "homepage": "https://www.tryagentgate.com",
  "bugs": {
    "url": "https://github.com/ElamOlame31/agentgate-public/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
