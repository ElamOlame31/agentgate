{
  "name": "agentgate-pdp",
  "version": "0.1.0",
  "description": "TypeScript/Node.js SDK for AgentGate — trust authorization for autonomous AI agents",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "keywords": [
    "ai", "agents", "security", "authorization", "langchain",
    "openai", "anthropic", "policy", "pdp", "agentgate"
  ],
  "author": "SynAI Solutions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElamOlame31/agentgate-public"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
